APP_ENV=development
APP_NAME=Lumivox AI API
APP_PORT=8000

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-service-role-or-secret-key

AI_INTERNAL_API_KEY=replace-with-a-long-random-secret

GEMINI_API_KEY=your-gemini-api-key
GEMINI_INSIGHT_MODEL=gemini-2.5-flash
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key
GROQ_STRUCTURED_MODELS=openai/gpt-oss-20b,openai/gpt-oss-120b
GROQ_CHAT_MODELS=llama-3.1-8b-instant,llama-3.3-70b-versatile,openai/gpt-oss-20b
LLM_REQUEST_TIMEOUT_SECONDS=30
LLM_MAX_ATTEMPTS_PER_MODEL=2

WEB_APP_URL=http://localhost:3000

# Native task risk model
NATIVE_TASK_RISK_REQUIRE_MODEL=false
NATIVE_TASK_RISK_MODEL_PATH=ml/artifacts/native-task-risk/logistic_regression_balanced.joblib
NATIVE_TASK_RISK_METADATA_PATH=ml/artifacts/native-task-risk/logistic_regression_balanced_metadata.json

# Legacy OULAD deadline-risk model (separate from native task risk)
DEADLINE_RISK_MODEL_PATH=ml/artifacts/deadline-risk/random_forest.joblib
ML_ARTIFACT_BUCKET=ml-artifacts
DEADLINE_RISK_MODEL_OBJECT_PATH=deadline-risk/random_forest.joblib
