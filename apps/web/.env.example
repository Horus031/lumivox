# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
SITE_URL=https://www.lumivox.it.com

AI_API_BASE_URL=http://127.0.0.1:8000
AI_INTERNAL_API_KEY=change-this-to-a-long-random-secret

# Protect scheduled web cron routes and the server-to-server native-risk cron call.
CRON_SECRET=change-this-to-a-long-random-secret
NATIVE_TASK_RISK_CRON_SECRET=change-this-to-a-different-long-random-secret

UPSTASH_REDIS_REST_URL=your-upstash-redis-url
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

E2E_TEST_EMAIL=your-dedicated-e2e-user@example.com
E2E_TEST_PASSWORD=use-a-secret-from-your-ci-environment
# Optional: when set, Playwright tests the deployed environment instead of localhost.
PLAYWRIGHT_BASE_URL=https://staging.example.com
